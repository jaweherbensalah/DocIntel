# Copy this file to `.env` and adjust as needed.
# Only API_KEY is required for the service to start.

# --- Auth (required) ---
# The key clients must send in the `x-api-key` header on every request.
# The app refuses to start if this is unset.
API_KEY=dev-local-key-change-me

# --- Database ---
# docker-compose sets this automatically for the api container; only set it
# here if you run the app outside compose.
# DATABASE_URL=postgresql+asyncpg://docintel:docintel@localhost:5432/docintel

# --- LLM provider ---
# "fake" (default, offline, no cost) or "openai".
# LLM_PROVIDER=fake
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- CORS ---
# JSON list of allowed browser origins, e.g. ["https://app.example.com"].
# Empty by default (no cross-origin browser access).
# CORS_ORIGINS=[]
